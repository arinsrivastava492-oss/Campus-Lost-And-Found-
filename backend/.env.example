# Rename this file to ".env" before running the server.
# Never commit your real ".env" file to GitHub.

# Port the Express server will run on
PORT=5000

# Your MongoDB connection string.
# Option 1 - Local MongoDB (if installed on your machine):
MONGO_URI=mongodb://127.0.0.1:27017/campus_lost_found

# Option 2 - MongoDB Atlas (free cloud database), looks like:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_lost_found

# Secret key used to sign JWT tokens. Use any long random string.
JWT_SECRET=replace_this_with_a_long_random_secret_string

# How long a login token stays valid
JWT_EXPIRES_IN=7d
